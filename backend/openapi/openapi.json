{
  "openapi": "3.0.3",
  "info": {
    "title": "GIS 3D Backend API",
    "version": "1.0.0",
    "description": "API for GIS region/building data and aggregate SIR simulation."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/v1/buildings": {
      "get": {
        "operationId": "listBuildings",
        "summary": "List buildings",
        "description": "Returns building footprints from PostGIS ordered by UUID ascending. An out-of-range page returns HTTP 200 with an empty data array.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "1-based page number.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "description": "Number of records per page; maximum 500.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 100
            }
          },
          {
            "name": "region_id",
            "in": "query",
            "required": false,
            "description": "Region UUID from public.regions.id.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Building page, including an empty page when no records match.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BuildingListResponse"
                },
                "examples": {
                  "withBuildings": {
                    "value": {
                      "data": [
                        {
                          "id": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
                          "region_id": "bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb",
                          "external_id": "way/123456",
                          "name": null,
                          "building_type": "residential",
                          "geometry": {
                            "type": "MultiPolygon",
                            "coordinates": [
                              [
                                [
                                  [
                                    106.695,
                                    10.765
                                  ],
                                  [
                                    106.696,
                                    10.765
                                  ],
                                  [
                                    106.696,
                                    10.766
                                  ],
                                  [
                                    106.695,
                                    10.766
                                  ],
                                  [
                                    106.695,
                                    10.765
                                  ]
                                ]
                              ]
                            ]
                          }
                        }
                      ],
                      "pagination": {
                        "page": 1,
                        "page_size": 100,
                        "total": 1,
                        "total_pages": 1
                      }
                    }
                  },
                  "empty": {
                    "value": {
                      "data": [],
                      "pagination": {
                        "page": 1,
                        "page_size": 100,
                        "total": 0,
                        "total_pages": 0
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid query parameter.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "region_id must be a valid UUID"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected database or server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "Internal server error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/regions": {
      "get": {
        "operationId": "listRegions",
        "summary": "List regions",
        "description": "Returns regions ordered by code ascending. An empty result is HTTP 200 with an empty data array.",
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegionListResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected database or server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "Internal server error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/regions/{region_id}": {
      "get": {
        "operationId": "getRegion",
        "summary": "Get region detail",
        "parameters": [
          {
            "name": "region_id",
            "in": "path",
            "required": true,
            "description": "Internal region UUID.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegionDetailResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid UUID or request parameter.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "region_id must be a valid UUID"
                }
              }
            }
          },
          "404": {
            "description": "Resource not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "Not found"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected database or server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "Internal server error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/buildings/{building_id}": {
      "get": {
        "operationId": "getBuildingDetail",
        "summary": "Get building detail",
        "parameters": [
          {
            "name": "building_id",
            "in": "path",
            "required": true,
            "description": "Internal building UUID.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BuildingDetailResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid UUID or request parameter.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "building_id must be a valid UUID"
                }
              }
            }
          },
          "404": {
            "description": "Resource not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "Not found"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected database or server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "Internal server error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/simulations/sir": {
      "post": {
        "operationId": "runSirSimulation",
        "summary": "Run aggregate SIR simulation",
        "description": "Runs the deterministic aggregate SIR engine synchronously. The response includes the initial state (time_step 0) and one point for each requested integration step. beta and gamma are rates in inverse time units; dt uses that same caller-defined time unit.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SirSimulationRequest"
              },
              "example": {
                "population": 10000,
                "susceptible": 9990,
                "infected": 10,
                "recovered": 0,
                "beta": 0.3,
                "gamma": 0.1,
                "dt": 1,
                "steps": 100
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Simulation completed. point_count equals steps + 1.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SirSimulationResponse"
                },
                "example": {
                  "population": 10000,
                  "point_count": 2,
                  "points": [
                    {
                      "time_step": 0,
                      "time": 0,
                      "susceptible": 9990,
                      "infected": 10,
                      "recovered": 0
                    },
                    {
                      "time_step": 1,
                      "time": 1,
                      "susceptible": 9987.003,
                      "infected": 11.997,
                      "recovered": 1
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Malformed JSON, missing/incorrect fields, or invalid SIR parameters.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "invalid JSON request body"
                }
              }
            }
          },
          "500": {
            "description": "Numerical instability or unexpected internal error. Internal details are not exposed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "Internal server error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BuildingListResponse": {
        "type": "object",
        "required": [
          "data",
          "pagination"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Building"
            }
          },
          "pagination": {
            "$ref": "#/components/schemas/Pagination"
          }
        }
      },
      "Building": {
        "type": "object",
        "required": [
          "id",
          "region_id",
          "external_id",
          "geometry"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "region_id": {
            "type": "string",
            "format": "uuid"
          },
          "external_id": {
            "type": "string",
            "example": "way/123456"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "building_type": {
            "type": "string",
            "nullable": true
          },
          "geometry": {
            "$ref": "#/components/schemas/MultiPolygon"
          }
        }
      },
      "MultiPolygon": {
        "type": "object",
        "required": [
          "type",
          "coordinates"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "MultiPolygon"
            ]
          },
          "coordinates": {
            "type": "array",
            "description": "GeoJSON coordinates in longitude, latitude order (EPSG:4326).",
            "items": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                }
              }
            }
          }
        }
      },
      "Pagination": {
        "type": "object",
        "required": [
          "page",
          "page_size",
          "total",
          "total_pages"
        ],
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "page_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          },
          "total": {
            "type": "integer",
            "minimum": 0,
            "description": "Total matching records after region filtering."
          },
          "total_pages": {
            "type": "integer",
            "minimum": 0,
            "description": "Zero when total is zero."
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "RegionListItem": {
        "type": "object",
        "required": [
          "id",
          "code",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "RegionListResponse": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RegionListItem"
            }
          }
        }
      },
      "RegionDetail": {
        "type": "object",
        "required": [
          "id",
          "code",
          "name",
          "boundary_method",
          "geometry"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "boundary_method": {
            "type": "string"
          },
          "source_reference": {
            "type": "string",
            "nullable": true
          },
          "geometry": {
            "$ref": "#/components/schemas/MultiPolygon"
          }
        }
      },
      "RegionDetailResponse": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/RegionDetail"
          }
        }
      },
      "BuildingDetail": {
        "type": "object",
        "required": [
          "id",
          "region_id",
          "external_id",
          "geometry"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "region_id": {
            "type": "string",
            "format": "uuid"
          },
          "external_id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "building_type": {
            "type": "string",
            "nullable": true
          },
          "geometry": {
            "$ref": "#/components/schemas/MultiPolygon"
          }
        }
      },
      "BuildingDetailResponse": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/BuildingDetail"
          }
        }
      },
      "SirSimulationRequest": {
        "type": "object",
        "required": [
          "population",
          "susceptible",
          "infected",
          "recovered",
          "beta",
          "gamma",
          "dt",
          "steps"
        ],
        "properties": {
          "population": {
            "type": "number",
            "format": "double",
            "exclusiveMinimum": 0,
            "description": "Total population; finite and greater than zero."
          },
          "susceptible": {
            "type": "number",
            "format": "double",
            "minimum": 0
          },
          "infected": {
            "type": "number",
            "format": "double",
            "minimum": 0
          },
          "recovered": {
            "type": "number",
            "format": "double",
            "minimum": 0
          },
          "beta": {
            "type": "number",
            "format": "double",
            "minimum": 0,
            "description": "Transmission rate in inverse caller-defined time units."
          },
          "gamma": {
            "type": "number",
            "format": "double",
            "minimum": 0,
            "description": "Recovery rate in inverse caller-defined time units."
          },
          "dt": {
            "type": "number",
            "format": "double",
            "exclusiveMinimum": 0,
            "description": "Integration interval in the same time unit as beta and gamma."
          },
          "steps": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          }
        },
        "description": "Initial susceptible + infected + recovered must equal population within the domain tolerance. dt × steps must not exceed 10,000 caller-defined time units."
      },
      "SirSimulationPoint": {
        "type": "object",
        "required": [
          "time_step",
          "time",
          "susceptible",
          "infected",
          "recovered"
        ],
        "properties": {
          "time_step": {
            "type": "integer",
            "minimum": 0
          },
          "time": {
            "type": "number",
            "format": "double",
            "minimum": 0,
            "description": "time_step × dt."
          },
          "susceptible": {
            "type": "number",
            "format": "double",
            "minimum": 0
          },
          "infected": {
            "type": "number",
            "format": "double",
            "minimum": 0
          },
          "recovered": {
            "type": "number",
            "format": "double",
            "minimum": 0
          }
        }
      },
      "SirSimulationResponse": {
        "type": "object",
        "required": [
          "population",
          "point_count",
          "points"
        ],
        "properties": {
          "population": {
            "type": "number",
            "format": "double"
          },
          "point_count": {
            "type": "integer",
            "minimum": 2,
            "description": "Number of returned points; always steps + 1, including the initial state."
          },
          "points": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SirSimulationPoint"
            }
          }
        }
      }
    }
  }
}
