# Used when running the backend directly with cargo run (not required by Docker Compose).
DATABASE_URL=postgres://appuser:YOUR_LOCAL_PASSWORD@localhost:5432/appdb
REDIS_URL=redis://localhost:6379

# Docker Compose settings. Set POSTGRES_PASSWORD in GitHub Codespaces Secrets;
# GitHub Actions also needs the independent Environment secret in environment `3d-gis`.
# Compose passes these fields separately so reserved password characters are safe.
# Do not commit a real password or paste it into chat.
POSTGRES_USER=appuser
POSTGRES_PASSWORD=REPLACE_WITH_A_LOCAL_SECRET
POSTGRES_DB=appdb

# Backend logging
RUST_LOG=backend=debug,tower_http=debug
