# Copy to .env. These are local-only development defaults, not production secrets.
# Replace passwords locally before exposing any service beyond loopback.
POSTGRES_DB=protein3d
POSTGRES_USER=protein3d
POSTGRES_PASSWORD=change_me_local_postgres
POSTGRES_PORT=5432

MINIO_ROOT_USER=protein3d
MINIO_ROOT_PASSWORD=change_me_local_minio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Optional graph profile
CASSANDRA_PORT=9042
ELASTICSEARCH_PORT=9200
JANUSGRAPH_PORT=8182

# Optional vector profile
MILVUS_PORT=19530
MILVUS_METRICS_PORT=9091
